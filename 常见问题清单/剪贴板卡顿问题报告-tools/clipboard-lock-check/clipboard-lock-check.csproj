<Project Sdk="Microsoft.NET.Sdk">
  <!--
    剪贴板持锁回归验证程序。独立于两个正式工程，未加入任何 .sln。
    构建：dotnet build clipboard-lock-check.csproj -p:GeneratePackageOnBuild=false
    运行：直接执行 exe，结果写入同目录 results.txt
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>clipboard-lock-check</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/StartUI4Controls/StartUI4Controls.csproj" />
  </ItemGroup>
</Project>
