<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 与库同策略：解除语言上限但不回写新语法，保持与 net48 基线逐行可比 -->
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>StartUI4Demo</RootNamespace>
    <AssemblyName>StartUI4Demo</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- .NET 10 的 WPF 仍按清单取 DPI 感知级别，PerMonitorV2 声明照旧生效 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/StartUI4Controls/StartUI4Controls.csproj" />
  </ItemGroup>

</Project>
